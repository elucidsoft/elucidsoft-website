---
/**
 * The portfolio as large, vivid tiles — the hero's visual.
 *
 * This is the element the earlier drafts were missing, and it is what both
 * working references in this category actually do. Bending Spoons fills the
 * fold with big rounded cards in each acquired brand's own colour, wordmark
 * large enough to read across a room. Tiny arcs its 21 holdings around the
 * headline as saturated circles. In both cases the holdings ARE the hero
 * image; there is no separate illustration, because the brands are the asset.
 *
 * Previous attempts here rendered the same six products as 24px monochrome
 * icons in hairline boxes. That is a favicon strip, and it reads as a
 * developer's link list. Scale and colour are the whole difference.
 *
 * Each tile is painted in that product's real accent, taken from its own
 * artwork, with the name set in dark ink — every one of the six accents is a
 * mid-to-light hue where white would fail contrast and dark ink clears 5:1.
 */
import { PRODUCTS } from '../data/portfolio';

interface Props {
  /** Slug to exclude, when the row appears on a product's own page. */
  exclude?: string;
}
const { exclude } = Astro.props;

const tiles = PRODUCTS.filter((p) => p.slug !== exclude);
---

<ul class="tiles" style={`--count: ${tiles.length};`}>
  {
    tiles.map((product, i) => (
      <li class="tiles__item" style={`--i: ${i};`}>
        <a
          class="tiles__link"
          href={`/portfolio/${product.slug}/`}
          style={`--accent: ${product.brand.accent}; --ink: ${product.brand.ink}; --ground: ${product.brand.ground};`}
        >
          <span class="tiles__mark">
            <img
              src={product.brand.logo}
              alt=""
              width="44"
              height="44"
              loading="eager"
              decoding="async"
            />
          </span>
          <span class="tiles__name">{product.name}</span>
          <span class="tiles__cat">{product.category}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .tiles {
    display: grid;
    grid-template-columns: repeat(var(--count), minmax(0, 1fr));
    gap: clamp(0.5rem, 1vw, 0.9rem);
    list-style: none;
    padding: 0;
  }

  .tiles__item {
    min-width: 0;
  }

  .tiles__link {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    height: 100%;
    padding: clamp(1rem, 1.6vw, 1.5rem);
    /* Painted in the product's own colour. This is the only place on the site
       where a surface carries a hue other than the parent's ground. */
    background: var(--accent);
    color: var(--ink);
    border-radius: 10px;
    aspect-ratio: 4 / 5;
    justify-content: space-between;
    transition:
      transform var(--t-base) var(--ease),
      filter var(--t-base) var(--ease);
  }

  .tiles__link:hover,
  .tiles__link:focus-visible {
    transform: translateY(-4px);
    filter: brightness(1.06);
  }

  /* The product's own mark keeps the ground it was drawn for; several of these
     are light-on-dark and would disappear painted straight onto the accent. */
  .tiles__mark {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    background: var(--ground);
    border-radius: 8px;
    flex: none;
  }

  .tiles__mark img {
    width: 1.6rem;
    height: 1.6rem;
    object-fit: contain;
  }

  .tiles__name {
    font-size: clamp(1rem, 1.35vw, 1.3rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-top: auto;
    overflow-wrap: anywhere;
  }

  /*
   * No opacity here. Fading this line to 0.72 dropped it under 4.5:1 on the
   * two darkest accents — the ink is chosen to clear contrast at full strength,
   * and any alpha applied afterwards silently undoes that. Size and weight
   * carry the hierarchy instead.
   */
  .tiles__cat {
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.3;
  }

  @media (max-width: 1080px) {
    .tiles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .tiles__link {
      aspect-ratio: 5 / 4;
    }
  }
</style>
