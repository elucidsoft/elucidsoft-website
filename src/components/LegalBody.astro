---
/**
 * Renders a legal document from the copy module.
 *
 * Legal text is authored as structured data — a list of headings with their
 * paragraphs — rather than as markdown, so that a page cannot acquire a
 * heading level or an inline style that the rest of the site does not have,
 * and so the whole document is reviewable in one file alongside the rest of
 * the copy.
 */
import { COMPANY, JURISDICTION } from '../data/company';
import { SAAS_PRODUCTS } from '../data/portfolio';

interface Section {
  heading: string;
  paragraphs: readonly string[];
  /** Appends the list of product sites, for sections that defer to them. */
  productLinks?: boolean;
}

interface Props {
  sections: readonly Section[];
  showAddress?: boolean;
}

const { sections, showAddress = false } = Astro.props;
---

<div class="legal">
  {
    sections.map((section) => (
      <section class="legal__section">
        <h2>{section.heading}</h2>
        {section.paragraphs.map((para) => (
          <p>{para}</p>
        ))}
        {section.productLinks && (
          <div class="link-list">
            {SAAS_PRODUCTS.map((product) => (
              <a href={product.url} rel="noopener">
                <span>
                  {product.name}: {product.displayUrl}
                </span>
              </a>
            ))}
          </div>
        )}
      </section>
    ))
  }

  {
    showAddress && (
      <p class="legal__address">
        <strong>{COMPANY.legalName}</strong>
        <span>{JURISDICTION}</span>
      </p>
    )
  }
</div>

<style>
  .legal {
    max-width: var(--measure-text);
  }

  .legal__section + .legal__section {
    margin-top: 2.25rem;
  }

  .legal h2 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    letter-spacing: -0.012em;
    color: var(--text-primary);
    margin-bottom: 0.8rem;
    padding-top: 1.3rem;
    border-top: 1px solid var(--rule-faint);
  }

  .legal p {
    color: var(--text-secondary);
    line-height: 1.7;
    text-wrap: pretty;
  }

  .legal p + p {
    margin-top: 1em;
  }

  .legal .link-list {
    margin-top: 1.1rem;
  }

  .legal__address {
    display: grid;
    gap: 0.05rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--text-tertiary);
    margin-top: 2.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule-faint);
  }

  .legal__address strong {
    color: var(--text-secondary);
    font-weight: 500;
  }
</style>
