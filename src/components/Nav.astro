---
/**
 * Site chrome.
 *
 * The nav is a hairline rule with the mark on the left and four links on the
 * right — no pill background, no blurred glass panel, no shrink-on-scroll.
 * The page is a document and the header is its running head.
 *
 * Mobile uses a <details> disclosure rather than a JavaScript drawer. It is
 * keyboard-operable and works before hydration, which for a nav is the whole
 * requirement.
 */
import Mark from './Mark.astro';
import ThemeToggle from './ThemeToggle.svelte';
import { COMPANY } from '../data/company';

const links = [
  { href: '/portfolio/', label: 'Products' },
  { href: '/open-source/', label: 'Open source' },
  { href: '/news/', label: 'News' },
  { href: '/about/', label: 'About' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="nav">
  <div class="nav__inner wrap">
    <a href="/" class="nav__brand" aria-label={`${COMPANY.shortName} home`}>
      <Mark size={46} id="nav" />
      <span class="nav__name">{COMPANY.shortName}</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      <div class="nav__theme-desktop">
        <ThemeToggle client:idle />
      </div>
      {
        links.map((link) => (
          <a
            href={link.href}
            class="nav__link"
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="nav__actions">
      <div class="nav__theme-mobile">
        <ThemeToggle client:idle />
      </div>
      <a
        class="nav__github"
        href={COMPANY.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Elucidsoft on GitHub"
        title="Elucidsoft on GitHub"
      >
        <svg
          width="19"
          height="19"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
          />
        </svg>
      </a>
      <a class="btn btn--sm btn--primary nav__cta" href="/contact/">Contact</a>
      <details class="nav__mobile">
        <summary aria-label="Menu"><span aria-hidden="true">≡</span></summary>
        <nav class="nav__drawer" aria-label="Primary">
          {links.map((link) => <a href={link.href}>{link.label}</a>)}
          <a href="/contact/">Contact</a>
          <a href={COMPANY.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--rule-faint);
    /* color-mix keeps the bar legible over scrolled content without a blur
       filter, which is expensive and reads as consumer-app chrome. */
    background: color-mix(in srgb, var(--ink-850) 88%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 4.75rem;
  }

  /* Pushes the links and actions to the right edge as one group. With
     space-between and three children the links would float to the centre. */
  .nav__links {
    margin-left: auto;
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
  }

  .nav__name {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--text-primary);
    white-space: nowrap;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.2vw, 2rem);
  }

  /* Sans, not mono. A monospaced nav reads as a developer's personal site;
     this one has to read as a company's. */
  .nav__link {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.003em;
    color: var(--text-tertiary);
    padding-block: 0.35rem;
    position: relative;
    transition: color var(--t-fast) var(--ease);
    white-space: nowrap;
  }

  .nav__link:hover,
  .nav__link:focus-visible {
    color: var(--text-primary);
  }

  /* The current page is marked with a gradient hairline, the same device the
     register uses for an active row. One idea, applied consistently. */
  .nav__link[aria-current='page'] {
    color: var(--text-primary);
  }

  .nav__link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.15rem;
    height: 1px;
    background: var(--brand-gradient-h);
  }

  /* The toggle sits outside the link group so it survives the mobile
     breakpoint — a theme control that disappears on a phone is worse than
     no control at all. */
  .nav__actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .nav__github {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    background: transparent;
    transition:
      color var(--t-fast) var(--ease),
      border-color var(--t-fast) var(--ease),
      background-color var(--t-fast) var(--ease),
      transform var(--t-fast) var(--ease);
  }

  .nav__github:hover,
  .nav__github:focus-visible {
    color: var(--text-primary);
    border-color: var(--rule-strong);
    background: var(--surface-raised);
    transform: translateY(-1px);
  }

  .nav__mobile {
    display: none;
    position: relative;
  }

  .nav__mobile summary {
    list-style: none;
    cursor: pointer;
    width: 2.25rem;
    height: 2.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--rule);
    color: var(--text-secondary);
    font-size: 1.1rem;
  }

  .nav__mobile summary::-webkit-details-marker {
    display: none;
  }

  .nav__drawer {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    min-width: 12rem;
    display: grid;
    background: var(--ink-800);
    border: 1px solid var(--rule);
    padding: 0.4rem;
  }

  .nav__drawer a {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-secondary);
    padding: 0.7rem 0.8rem;
  }

  .nav__drawer a:hover,
  .nav__drawer a:focus-visible {
    color: var(--text-primary);
    background: var(--surface-raised);
  }

  .nav__theme-desktop {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .nav__theme-mobile {
    display: none;
  }

  @media (max-width: 820px) {
    .nav__links {
      display: none;
    }
    .nav__theme-desktop {
      display: none;
    }
    .nav__theme-mobile {
      display: inline-flex;
      align-items: center;
    }
    /* With the link group gone, the actions group takes over pushing right. */
    .nav__actions {
      margin-left: auto;
    }
    .nav__mobile {
      display: block;
    }
  }
</style>
