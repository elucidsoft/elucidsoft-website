---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import BrandCard from '../../components/BrandCard.astro';
import { COPY } from '../../data/copy';
import {
  PRODUCTS,
  STAGE_LABEL,
  DIVISION_LABEL,
  RELATIONSHIP_LABEL,
  type Product,
} from '../../data/portfolio';
import { graph, organizationSchema, productSchema } from '../../lib/schema';
import { breadcrumbSchema } from '../../lib/seo';
import IconArrow from '../../components/IconArrow.astro';

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product }: Props = Astro.props;
const copy = COPY.PRODUCTS[product.slug as keyof typeof COPY.PRODUCTS];

/** Every other product, for the "rest of the portfolio" register. */
const siblings = PRODUCTS.filter((p) => p.slug !== product.slug);

/*
 * The reciprocal half of the entity graph. Organization is emitted here too,
 * not only on the homepage, so that a crawler landing directly on a product
 * page from a search result resolves `parentOrganization` without a second
 * fetch. An @id reference to a node it has never seen is a dangling edge.
 */
const jsonLd = graph(
  organizationSchema(),
  productSchema(product, copy.summary),
  breadcrumbSchema([
    { name: 'Home', href: '/' },
    { name: COPY.PORTFOLIO.title, href: '/portfolio' },
    { name: product.name, href: `/portfolio/${product.slug}` },
  ]),
);
---

<Base title={copy.metaTitle} description={copy.metaDescription} jsonLd={jsonLd}>
  <!-- 01 — Masthead -->
  <section class="head">
    <div class="wrap">
      <div class="section__inner">
        <div class="section__num" aria-hidden="true">01 —</div>
        <div class="section__body">
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href="/portfolio/">{COPY.PORTFOLIO.title}</a>
            <span aria-hidden="true">/</span>
            <span>{DIVISION_LABEL[product.division]}</span>
          </nav>
          <h1 class="display display--page" data-rise="1">{product.name}</h1>
          <div class="brand-rule head__rule" data-draw></div>
          <p class="lead" data-rise="3">{copy.summary}</p>
          <div class="head__actions" data-rise="4">
            <a class="btn" href={product.url} rel="noopener">
              Visit {product.displayUrl}
              <IconArrow direction="up-right" size={14} />
            </a>
            {
              product.github && (
                <a class="btn btn--quiet" href={product.github} rel="noopener">
                  Source
                  <IconArrow direction="up-right" size={14} />
                </a>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 — Record -->
  <Section eyebrow="Record" title="At a glance">
    <div class="two-col">
      <!--
        The quote needs this label. Every one of these lines opens with
        "Because…", which dangles when nothing on the page asks a question —
        the reader meets an answer to something they were never shown. The
        label is the question.
      -->
      <div class="why">
        <h3 class="label why__head">Why it exists</h3>
        <blockquote class="pull">
          <p>{copy.whyItExists}</p>
        </blockquote>
      </div>

      <dl class="defs">
        <div class="defs__row">
          <dt class="defs__key">Division</dt>
          <dd class="defs__val">{DIVISION_LABEL[product.division]}</dd>
        </div>
        <div class="defs__row">
          <dt class="defs__key">Relationship</dt>
          <dd class="defs__val">{RELATIONSHIP_LABEL[product.relationship]}</dd>
        </div>
        <div class="defs__row">
          <dt class="defs__key">Stage</dt>
          <dd class="defs__val">{STAGE_LABEL[product.stage]}</dd>
        </div>
        <div class="defs__row">
          <dt class="defs__key">Category</dt>
          <dd class="defs__val">{product.category}</dd>
        </div>
        <div class="defs__row">
          <dt class="defs__key">Built for</dt>
          <dd class="defs__val">{product.audience}</dd>
        </div>
        {
          product.version && (
            <div class="defs__row">
              <dt class="defs__key">Version</dt>
              <dd class="defs__val mono">{product.version}</dd>
            </div>
          )
        }
        {
          product.license && (
            <div class="defs__row">
              <dt class="defs__key">Licence</dt>
              <dd class="defs__val mono">{product.license}</dd>
            </div>
          )
        }
        {
          product.foundedYear && (
            <div class="defs__row">
              <dt class="defs__key">Operating since</dt>
              <dd class="defs__val">{product.foundedYear}</dd>
            </div>
          )
        }
        <div class="defs__row">
          <dt class="defs__key">Built with</dt>
          <dd class="defs__val">{product.tech.join(', ')}</dd>
        </div>
        <div class="defs__row">
          <dt class="defs__key">Site</dt>
          <dd class="defs__val">
            <a class="link" href={product.url} rel="noopener">{product.displayUrl}</a>
          </dd>
        </div>
      </dl>
    </div>
  </Section>

  <!-- 03 — Detail -->
  <Section eyebrow="Detail" title={`What ${product.name} is`}>
    <div class="prose detail">
      {copy.body.map((para) => <p>{para}</p>)}
    </div>
  </Section>

  <!-- 04 — Links and packages -->
  <Section eyebrow="Elsewhere" title="Links">
    <div class="two-col">
      <div>
        <h3 class="label links__head">On {product.displayUrl}</h3>
        <div class="link-list">
          {
            product.links?.map((link) => (
              <a href={link.href} rel="noopener">
                <span>{link.label}</span>
              </a>
            ))
          }
        </div>
      </div>

      {
        product.npmPackages && (
          <div>
            <h3 class="label links__head">Published packages</h3>
            <div class="link-list">
              {product.npmPackages.map((pkg) => (
                <a href={`https://www.npmjs.com/package/${pkg}`} rel="noopener">
                  <span class="mono">{pkg}</span>
                </a>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </Section>

  <!-- 05 — Rest of the portfolio -->
  <Section eyebrow="Portfolio" title="Elsewhere in the portfolio">
    <div class="siblings">
      {
        siblings.map((sibling) => (
          <BrandCard
            product={sibling}
            summary={COPY.PRODUCTS[sibling.slug as keyof typeof COPY.PRODUCTS].blurb}
          />
        ))
      }
    </div>
  </Section>
</Base>

<style>
  .head {
    padding-block: clamp(3rem, 9vh, 6rem) var(--section-y);
  }

  .crumbs {
    display: flex;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--label-size);
    letter-spacing: var(--label-tracking);
    text-transform: uppercase;
    color: var(--text-quaternary);
    margin-bottom: 1.5rem;
  }

  .crumbs a {
    color: var(--text-tertiary);
    transition: color var(--t-fast) var(--ease);
  }

  .crumbs a:hover,
  .crumbs a:focus-visible {
    color: var(--text-primary);
  }

  .head__rule {
    margin-block: clamp(1.25rem, 2.5vw, 1.85rem);
  }

  .head__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .btn--quiet {
    border-color: var(--rule);
    color: var(--text-secondary);
  }

  .why__head {
    display: block;
    margin-bottom: 0.9rem;
  }

  /*
   * The pull-quote is the one place a product page raises its voice, set large
   * with the brand gradient held still down the left edge.
   */
  .pull {
    border-left: 3px solid transparent;
    border-image: var(--brand-gradient) 1;
    padding-left: clamp(1.25rem, 2.5vw, 2rem);
  }

  .pull p {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(1.35rem, 2.6vw, 1.85rem);
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--text-primary);
    text-wrap: pretty;
  }

  .detail p {
    font-size: 1.0625rem;
  }

  .links__head {
    display: block;
    margin-bottom: 0.85rem;
  }

  .siblings {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: 1rem;
  }
</style>
