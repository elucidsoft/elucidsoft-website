{
  "name": "elucidsoft-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Corporate umbrella site for Elucidsoft LLC",
  "scripts": {
    "dev": "astro dev --port 4325 --host",
    "start": "astro dev --port 4325",
    "build": "bun scripts/og-images.mjs --check && astro build",
    "build:full": "bun scripts/og-images.mjs && astro build",
    "preview": "astro preview --port 4325",
    "check": "astro check",
    "og": "bun scripts/og-images.mjs",
    "og:check": "bun scripts/og-images.mjs --check",
    "links": "bunx linkinator dist --recurse --silent"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.0",
    "@astrojs/svelte": "^7.0.9",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "astro": "^5.7.10",
    "svelte": "5.30.1",
    "@elucidsoft/astro-markdown-negotiation": "workspace:*"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/bun": "^1.3.14",
    "sharp": "^0.35.3",
    "typescript": "6.0.2"
  }
}
